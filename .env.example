# Neo4j. With docker compose the bundled container is used and only the
# password matters (at least 8 characters). The URI is for running the API or
# the evaluation from your machine.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me-please
NEO4J_DATABASE=neo4j

# Amazon Bedrock API key (us-east-1)
AWS_BEARER_TOKEN_BEDROCK=

AGENT_LLM=us.amazon.nova-2-lite-v1:0
PAPER_LLM=us.anthropic.claude-sonnet-4-6
GRAPH_LLM=us.amazon.nova-2-lite-v1:0
EVALUATION_LLM=us.amazon.nova-lite-v1:0

CHUNK_SIZE=1200
CHUNK_OVERLAP=200
DATA_DIR=data/
