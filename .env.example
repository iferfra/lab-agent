# Neo4j Aura: copy these values from the credentials file Aura downloads when
# you create the instance (see "Getting started" in the README)
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# Amazon Bedrock API key (us-east-1)
AWS_BEARER_TOKEN_BEDROCK=

AGENT_LLM=us.amazon.nova-2-lite-v1:0
PAPER_LLM=us.anthropic.claude-sonnet-4-6
GRAPH_LLM=us.amazon.nova-2-lite-v1:0
EVALUATION_LLM=us.amazon.nova-lite-v1:0
# Optional reranker for text search; leave empty to disable
RERANK_MODEL=cohere.rerank-v3-5:0

CHUNK_SIZE=1200
CHUNK_OVERLAP=200
DATA_DIR=data/
